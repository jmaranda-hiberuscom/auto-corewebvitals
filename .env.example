# Copia este archivo a .env y ejecuta: npm run start:local
URLS_TO_CHECK=https://www.example.com/,https://www.example.com/contacto
# Slack (hooks.slack.com), Teams Workflows (*.logic.azure.com / *.powerplatform.com) o cualquier endpoint JSON.
# Si se deja vacío, el payload de alerta se imprime por consola en lugar de enviarse.
WEBHOOK_URL=
MAX_LCP=2500
MAX_CLS=0.1
MAX_INP=200
# Ejecuciones por URL; se usa la mediana para reducir falsos positivos.
RUNS_PER_URL=3
