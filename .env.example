# Copia este archivo a .env y configura una API key de Google Cloud con CrUX API habilitada.
# El cron de GitHub Actions está en .github/workflows/cwb-monitor.yml (diario, 07:17 UTC).
CRUX_API_KEY=
CRUX_ORIGINS=https://example.com
CRUX_DEVICES=MOBILE,DESKTOP

# Actions proporciona GITHUB_TOKEN y GITHUB_REPOSITORY automaticamente.
# No se necesitan claves de correo ni aplicaciones externas para publicar.
# REPORT_ISSUE_NUMBER es opcional; vacio crea o reutiliza la issue del monitor.
REPORT_ISSUE_NUMBER=

# Umbrales p75 configurables para alertas de datos de campo.
MAX_LCP=2500
MAX_CLS=0.1
MAX_INP=200
