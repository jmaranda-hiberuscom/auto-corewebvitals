# Copia este archivo a .env. Para iniciar sesión manualmente ejecuta npm run auth.
# El cron de GitHub Actions está en .github/workflows/cwb-monitor.yml (*/10 minutos).
GSC_PROPERTIES=sc-domain:example.com
GSC_STORAGE_STATE_PATH=.auth/gsc-storage-state.json
# En GitHub Actions guarda el base64 del estado como el secret GSC_STORAGE_STATE_BASE64.
GSC_STORAGE_STATE_BASE64=
GSC_DEVICES=MOBILE,DESKTOP

# Resend: usa un remitente verificado en tu cuenta.
EMAIL_API_KEY=
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_FROM=cwv@example.com
EMAIL_TO=equipo@example.com

# Search Console solo permite comparar sus categorías oficiales de Core Web Vitals.
MAX_LCP=2500
MAX_CLS=0.1
MAX_INP=200
